<%
  var cover = page.cover || page.top_img || theme.post.default_cover || '';
  var cats = (page.categories && page.categories.length) ? page.categories.toArray() : [];
  var tags = (page.tags && page.tags.length) ? page.tags.toArray() : [];
  var author = config.author || config.title;
  var avatar = lb_author().avatar || '/images/avatar.svg';

  /* 相关推荐：同分类下最新文章，排除自己 */
  var related = [];
  if (cats.length) {
    var q = site.categories.findOne({ name: cats[0].name });
    if (q && q.posts) {
      q.posts.sort('date', -1).each(function (p) {
        if (related.length >= 3 || p._id === page._id) return;
        related.push(p);
      });
    }
  }
  if (related.length < 3) {
    site.posts.sort('date', -1).each(function (p) {
      if (related.length >= 3 || p._id === page._id) return;
      if (related.some(function (r) { return r._id === p._id; })) return;
      related.push(p);
    });
  }

  /* 版权卡：主题配置 post.copyright
     写 false 整块不显示；写 true 用默认值；也可写成对象做细调：
       enable          总开关，false 不显示
       about           点头像去哪，默认 /about/
       reward          打赏按钮，默认显示，写 false 关掉
       reward_images   打赏二维码，写字符串或 { img, name } 都行
       subscribe       订阅按钮 → 「订阅博客更新」弹窗
       share           分享按钮
       cc_name/cc_url  协议名称与链接 */
  var cpRaw = theme.post.copyright;
  var cpOn = cpRaw !== false && !(cpRaw && cpRaw.enable === false);
  var cp = (cpRaw && typeof cpRaw === 'object') ? cpRaw : {};
  var rewardList = (cp.reward_images || []).map(function (it) {
    if (typeof it === 'string') return { img: it, name: '' };
    return { img: (it && (it.img || it.image)) || '', name: (it && it.name) || '' };
  }).filter(function (it) { return !!it.img; });
  /* 一张二维码都没配就别显示「打赏作者」—— 点了只会弹出「还没放打赏码」 */
  var showReward = cpOn && cp.reward !== false && rewardList.length > 0;
  /* 打赏面板文案（对齐 blog.anheyu.com 的面板结构） */
  var rewardTitle = cp.reward_title || '感谢你赐予我前进的力量';
  var rewardListCfg = (cp.reward_list && typeof cp.reward_list === 'object') ? cp.reward_list : {};
  var rewardListUrl = rewardListCfg.enable === false ? '' : (rewardListCfg.url || '/about/');
  var rewardListText = rewardListCfg.text || '打赏者名单';
  var rewardListDesc = rewardListCfg.desc || '因为你们的支持让我意识到写文章的价值';
  var sub = cp.subscribe && typeof cp.subscribe === 'object' ? cp.subscribe : {};
  var showSubscribe = cpOn && cp.subscribe !== false && sub.enable !== false;
  var showShare = cpOn && cp.share !== false;
  var ccName = cp.cc_name || 'CC BY-NC-SA 4.0';
  var ccUrl = cp.cc_url || 'https://creativecommons.org/licenses/by-nc-sa/4.0/';

  /* 分享 / 订阅弹窗要用的数据 */
  var shareData = {
    url: page.permalink,
    title: page.title,
    desc: strip_html(page.excerpt || page.description || page.content || '')
      .replace(/\s+/g, ' ').trim().slice(0, 90),
    cover: cover ? url_for(cover) : '',
    site: config.title,
    sub: config.subtitle || '',
    avatar: url_for(avatar)
  };
  /* 订阅：目标站是「邮箱 + 验证码」两步，静态站自己发不了信，
     所以两个地址都交给站长填：endpoint 订阅、code_endpoint 发验证码。
     两个都空着时，弹窗照常显示，点按钮只会提示未配置。 */
  var subEndpoint = sub.endpoint || '';
  var subCodeEndpoint = sub.code_endpoint || subEndpoint;
  var subMethod = (sub.method || 'post').toLowerCase();
  var subField = sub.field || 'email';
  var subCodeField = sub.code_field || 'code';
  var subSuccess = sub.success_text || '订阅成功，请去邮箱确认';
%>
<div id="post">
  <article id="article-container" class="post-content" itemscope itemtype="http://schema.org/BlogPosting">
    <%- page.content %>
  </article>

  <% if (tags.length) { %>
  <div class="post-tags-block">
    <div class="post-tags-block-title"><i class="heoblogIcon icon-price-tag-3-fill"></i>标签</div>
    <div class="post-tags-block-list">
      <% tags.forEach(function (t) { %>
      <a class="post-tag-item" href="<%- url_for(t.path) %>" title="<%= t.name %>" heotip="查看 <%= t.name %> 标签下的文章"><%= t.name %></a>
      <% }); %>
    </div>
  </div>
  <% } %>

  <% if (cpOn) { %>
  <div class="post-copyright">
    <a class="post-copyright__avatar" href="<%- url_for(cp.about || '/about/') %>" title="关于作者">
      <img src="<%- url_for(avatar) %>" alt="作者头像" loading="lazy" decoding="async">
    </a>
    <div class="post-copyright__name"><%= author %></div>
    <% if (config.subtitle) { %><div class="post-copyright__desc"><%= config.subtitle %></div><% } %>
    <% if (showReward || showSubscribe || showShare) { %>
    <div class="post-copyright__actions">
      <% if (showReward) { %>
      <div class="pc-reward">
        <button type="button" class="pc-btn pc-btn--reward" onclick="heo.toggleReward(this)" aria-haspopup="true" aria-expanded="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M9.335 11.502h2.17a4.5 4.5 0 0 1 4.5 4.5H9.004v1h8v-1a5.6 5.6 0 0 0-.885-3h2.886a5 5 0 0 1 4.516 2.852c-2.365 3.12-6.194 5.149-10.516 5.149c-2.761 0-5.1-.59-7-1.625v-9.304a6.97 6.97 0 0 1 3.33 1.428m-5.33-2.5a1 1 0 0 1 .993.884l.007.116v9a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1zm9.646-5.424l.354.354l.353-.354a2.5 2.5 0 0 1 3.536 3.536l-3.89 3.889l-3.888-3.89a2.5 2.5 0 1 1 3.535-3.535"/></svg>
          <span>打赏作者</span>
        </button>
        <div class="pc-reward-main" role="dialog" aria-label="打赏作者">
          <div class="pc-reward-all">
            <span class="pc-reward-title"><%= rewardTitle %></span>
            <ul class="pc-reward-group">
              <% rewardList.forEach(function (it) { %>
              <li class="pc-reward-item">
                <a href="<%- url_for(it.img) %>" target="_blank" rel="noopener noreferrer">
                  <img class="pc-qr" src="<%- url_for(it.img) %>" alt="<%= it.name || '打赏二维码' %>" width="130" height="130" loading="lazy" decoding="async">
                </a>
                <% if (it.name) { %><div class="pc-qr-desc"><%= it.name %></div><% } %>
              </li>
              <% }); %>
            </ul>
            <% if (rewardListUrl) { %>
            <a class="pc-reward-list" href="<%- url_for(rewardListUrl) %>">
              <div class="pc-reward-text"><%= rewardListText %></div>
              <div class="pc-reward-dec"><%= rewardListDesc %></div>
            </a>
            <% } %>
          </div>
        </div>
      </div>
      <% } %>
      <% if (showSubscribe) { %>
      <button type="button" class="pc-btn pc-btn--subscribe" onclick="heo.openSubscribe(this)" aria-haspopup="dialog">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.998 3v2a7 7 0 0 1-7 7h-1v1h5v7a2 2 0 0 1-2 2h-8a2 2 0 0 1-2-2v-7h5v-3a7 7 0 0 1 7-7zm-15.5-1a7.49 7.49 0 0 1 6.124 3.169A7.96 7.96 0 0 0 9.998 10v1h-.5a7.5 7.5 0 0 1-7.5-7.5V2z"/></svg>
        <span>订阅</span>
      </button>
      <% } %>
      <% if (showShare) { %>
      <button type="button" class="pc-btn pc-btn--share" onclick="heo.openShare(this)" aria-haspopup="dialog">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.028 14.094a.4.4 0 0 0-.137.285a45 45 0 0 1-.25 3.032c-.154 1.318-1.22 2.367-2.55 2.516a46.2 46.2 0 0 1-10.183 0a2.89 2.89 0 0 1-2.55-2.516a44.4 44.4 0 0 1 0-10.32a2.89 2.89 0 0 1 2.55-2.517a46 46 0 0 1 6.725-.252c.163.005.3-.118.312-.28l.05-.703q.003-.062.012-.123c.024-.194-.11-.386-.307-.393a48 48 0 0 0-6.958.26c-2.012.226-3.637 1.81-3.873 3.833a46 46 0 0 0 0 10.67c.236 2.022 1.86 3.607 3.873 3.832a47.8 47.8 0 0 0 10.516 0c2.012-.225 3.637-1.81 3.873-3.833a46 46 0 0 0 .3-4.347c.004-.183-.22-.273-.347-.144q-.51.519-1.056 1"/><path fill="currentColor" d="M7.867 15.55a.5.5 0 0 1-.367-.494l.06-2.463a6.5 6.5 0 0 1 6.498-6.344h1.257q.04-.936.107-1.87l.068-.93a.752.752 0 0 1 1.155-.58a19.4 19.4 0 0 1 5.305 5.025l.456.635a.5.5 0 0 1 0 .583l-.456.635a19.4 19.4 0 0 1-5.305 5.024a.754.754 0 0 1-1.083-.303a.8.8 0 0 1-.072-.275l-.068-.931a61 61 0 0 1-.121-2.23l-.354-.054a5.5 5.5 0 0 0-5.61 2.736l-.902 1.6a.5.5 0 0 1-.568.236"/></svg>
        <span>分享</span>
      </button>
      <% } %>
    </div>
    <% } %>
    <div class="post-copyright__notice">
      本文是原创文章，采用 <a href="<%- ccUrl %>" target="_blank" rel="external nofollow noopener"><%= ccName %></a> 协议，完整转载请注明来自 <a href="<%- url_for('/') %>" target="_blank" rel="noopener"><%= config.title %></a>
    </div>
  </div>
  <% } %>

  <% if (showSubscribe) { %>
  <% /* ---------------- 订阅弹窗（对齐 blog.anheyu.com：单栏邮件订阅） ---------------- */ %>
  <div class="pc-modal pc-modal--sub" id="pc-sub-modal" hidden
       data-endpoint="<%= subEndpoint %>"
       data-code-endpoint="<%= subCodeEndpoint %>"
       data-method="<%= subMethod %>"
       data-field="<%= subField %>"
       data-code-field="<%= subCodeField %>"
       data-success="<%= subSuccess %>">
    <div class="pc-modal-mask" data-pc-close></div>
    <div class="pc-modal-box pc-modal-box--sub" role="dialog" aria-modal="true" aria-labelledby="pc-sub-title">
      <div class="pc-modal-head">
        <h3 id="pc-sub-title">订阅博客更新</h3>
        <button type="button" class="pc-modal-x" data-pc-close aria-label="关闭">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M18.3 5.71a1 1 0 0 0-1.41 0L12 10.59L7.11 5.7A1 1 0 0 0 5.7 7.11L10.59 12L5.7 16.89a1 1 0 1 0 1.41 1.41L12 13.41l4.89 4.89a1 1 0 0 0 1.41-1.41L13.41 12l4.89-4.89a1 1 0 0 0 0-1.4"/></svg>
        </button>
      </div>
      <div class="pc-modal-body pc-sub-body">
        <p class="pc-sub-desc">输入您的邮箱，获取最新文章推送</p>
        <form class="pc-sub-form" novalidate>
          <input type="email" class="pc-sub-input" name="email" placeholder="请输入您的邮箱" autocomplete="email">
          <div class="pc-sub-coderow">
            <input type="text" class="pc-sub-input pc-sub-code" name="code" placeholder="请输入验证码" inputmode="numeric" autocomplete="one-time-code">
            <button type="button" class="pc-sub-send">发送验证码</button>
          </div>
          <button type="submit" class="pc-sub-submit">订阅</button>
        </form>
        <p class="pc-sub-tips">您可以随时通过邮件中的链接取消订阅</p>
      </div>
    </div>
  </div>
  <% } %>

  <% if (showShare) { %>
  <% /* ---------------- 分享弹窗 ---------------- */ %>
  <div class="pc-modal" id="pc-share-modal" hidden
       data-url="<%= shareData.url %>"
       data-title="<%= shareData.title %>"
       data-desc="<%= shareData.desc %>"
       data-cover="<%= shareData.cover %>"
       data-site="<%= shareData.site %>"
       data-sub="<%= shareData.sub %>"
       data-avatar="<%= shareData.avatar %>">
    <div class="pc-modal-mask" data-pc-close></div>
    <div class="pc-modal-box pc-modal-box--share" role="dialog" aria-modal="true" aria-labelledby="pc-share-title">
      <div class="pc-modal-head">
        <h3 id="pc-share-title">分享海报</h3>
        <button type="button" class="pc-modal-x" data-pc-close aria-label="关闭">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M18.3 5.71a1 1 0 0 0-1.41 0L12 10.59L7.11 5.7A1 1 0 0 0 5.7 7.11L10.59 12L5.7 16.89a1 1 0 1 0 1.41 1.41L12 13.41l4.89 4.89a1 1 0 0 0 1.41-1.41L13.41 12l4.89-4.89a1 1 0 0 0 0-1.4"/></svg>
        </button>
      </div>
      <div class="pc-modal-body pc-share-body">
        <div class="pc-poster-col">
          <div class="pc-poster" id="pc-poster" data-loading="1">
            <img class="pc-poster-img" alt="分享海报" hidden>
            <div class="pc-poster-loading">
              <span class="pc-spinner"></span>
              <span>正在生成海报…</span>
            </div>
          </div>
        </div>

        <div class="pc-share-col">
          <div class="pc-share-section">
            <div class="pc-share-label">点击复制链接：</div>
            <input type="text" class="pc-share-url" readonly value="<%= shareData.url %>">
          </div>

          <div class="pc-share-section">
            <div class="pc-share-label">分享到：</div>
            <div class="pc-share-links">
              <a class="pc-share-link pc-share-link--weibo" data-share="weibo" href="#" target="_blank" rel="noopener nofollow">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M4.278 8.592c2.773-2.77 6.004-4.033 7.219-2.816c.537.537.588 1.464.244 2.572c-.178.557.524.25.524.25c2.241-.938 4.197-.994 4.91.027c.38.542.343 1.306-.008 2.19c-.163.407.048.47.36.563c1.262.392 2.668 1.336 2.668 3.004c0 2.763-3.98 6.239-9.964 6.239c-4.565 0-9.23-2.213-9.23-5.852c0-1.902 1.204-4.102 3.277-6.177m12.133 5.742c-.237-2.391-3.382-4.039-7.023-3.677c-3.64.359-6.403 2.59-6.167 4.98c.237 2.394 3.382 4.039 7.023 3.68c3.641-.362 6.401-2.592 6.167-4.983m-10.249.104c.754-1.528 2.712-2.39 4.446-1.94c1.792.463 2.707 2.154 1.976 3.799c-.744 1.683-2.883 2.58-4.695 1.994c-1.752-.566-2.493-2.295-1.727-3.853m2.715.578c-.563-.237-1.291.008-1.64.553c-.354.547-.189 1.201.371 1.456c.568.257 1.325.013 1.676-.55c.346-.568.163-1.217-.408-1.459m1.387-.578c-.216-.084-.486.018-.613.232c-.123.214-.054.458.163.547c.219.092.501-.012.628-.231c.123-.22.044-.466-.178-.548m5.694-11.514A5.83 5.83 0 0 1 21.5 4.72a5.84 5.84 0 0 1 1.22 5.704a.84.84 0 0 1-1.06.54a.844.844 0 0 1-.542-1.062a4.142 4.142 0 0 0-4.808-5.327a.845.845 0 0 1-.353-1.65m.626 2.926a2.836 2.836 0 0 1 3.29 3.648a.725.725 0 1 1-1.378-.45a1.38 1.38 0 0 0-.287-1.357a1.4 1.4 0 0 0-1.322-.426a.723.723 0 1 1-.303-1.415"/></svg>
                <span>微博</span>
              </a>
              <a class="pc-share-link pc-share-link--qq" data-share="qq" href="#" target="_blank" rel="noopener nofollow">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M19.914 14.529a32 32 0 0 0-.676-1.886l-.91-2.246c.002-.026.013-.468.013-.696C18.34 5.86 16.508 2 12 2S5.66 5.86 5.66 9.7c0 .229.011.671.012.697l-.91 2.246a32 32 0 0 0-.675 1.886c-.86 2.737-.581 3.87-.369 3.895c.455.054 1.771-2.06 1.771-2.06c0 1.224.637 2.822 2.016 3.976c-.515.157-1.147.399-1.554.695c-.365.267-.319.54-.253.65c.289.481 4.955.307 6.303.157c1.347.15 6.014.324 6.302-.158c.066-.11.112-.382-.253-.649c-.407-.296-1.039-.538-1.555-.695c1.379-1.154 2.016-2.752 2.016-3.977c0 0 1.316 2.115 1.771 2.06c.212-.025.49-1.157-.37-3.894"/></svg>
                <span>QQ好友</span>
              </a>
              <a class="pc-share-link pc-share-link--qzone" data-share="qzone" href="#" target="_blank" rel="noopener nofollow">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M19.914 14.529a32 32 0 0 0-.676-1.886l-.91-2.246c.002-.026.013-.468.013-.696C18.34 5.86 16.508 2 12 2S5.66 5.86 5.66 9.7c0 .229.011.671.012.697l-.91 2.246a32 32 0 0 0-.675 1.886c-.86 2.737-.581 3.87-.369 3.895c.455.054 1.771-2.06 1.771-2.06c0 1.224.637 2.822 2.016 3.976c-.515.157-1.147.399-1.554.695c-.365.267-.319.54-.253.65c.289.481 4.955.307 6.303.157c1.347.15 6.014.324 6.302-.158c.066-.11.112-.382-.253-.649c-.407-.296-1.039-.538-1.555-.695c1.379-1.154 2.016-2.752 2.016-3.977c0 0 1.316 2.115 1.771 2.06c.212-.025.49-1.157-.37-3.894"/></svg>
                <span>QQ空间</span>
              </a>
              <button type="button" class="pc-share-link pc-share-link--system" data-share="system" hidden>系统分享</button>
            </div>
          </div>

          <div class="pc-share-section">
            <div class="pc-share-label">下载海报：</div>
            <button type="button" class="pc-poster-dl">点击下载</button>
          </div>
        </div>
      </div>
    </div>
  </div>
  <% } %>

  <div class="post-bottom-tools">
    <div class="post-tools-left">
      <span class="post-tools-date"><i class="heoblogIcon icon-calendar-todo-fill"></i>发布于 <%= date(page.date, 'YYYY-MM-DD') %></span>
    </div>
    <div class="post-tools-right">
      <% if (config.url) { %>
      <a class="post-report" href="javascript:void(0);" onclick="heo.copyLink('<%- page.permalink %>')" heotip="复制本文链接">
        <i class="heoblogIcon icon-file-copy-fill"></i>复制链接
      </a>
      <% } %>
    </div>
  </div>

  <% if (theme.post.prev_next !== false) { %>
  <nav id="pagination" class="pagination-post">
    <div class="heo-dock-surface">
      <div class="prev-post pull-left">
        <% if (page.prev) { %>
        <a href="<%- url_for(page.prev.path) %>" title="<%= page.prev.title %>">
          <div class="pagination-info">
            <div class="label">上一篇</div>
            <div class="prev_info"><%= page.prev.title %></div>
          </div>
        </a>
        <% } else { %>
        <div class="pagination-info"><div class="label">上一篇</div><div class="prev_info">没有更早的文章了</div></div>
        <% } %>
      </div>
      <div class="next-post pull-right">
        <% if (page.next) { %>
        <a href="<%- url_for(page.next.path) %>" title="<%= page.next.title %>">
          <div class="pagination-info">
            <div class="label">下一篇</div>
            <div class="next_info"><%= page.next.title %></div>
          </div>
        </a>
        <% } else { %>
        <div class="pagination-info"><div class="label">下一篇</div><div class="next_info">没有更新的文章了</div></div>
        <% } %>
      </div>
    </div>
  </nav>
  <% } %>

  <% if (related.length) { %>
  <div class="relatedPosts">
    <div class="headline">
      <i class="heoblogIcon icon-star-smile-fill"></i>
      <span> 喜欢这篇文章的人也看了</span>
      <div class="relatedPosts-link">
        <a href="<%- url_for('/archives/') %>" rel="external nofollow">更多文章</a>
      </div>
    </div>
    <div class="relatedPosts-list">
      <% related.forEach(function (p) { %>
      <div style="--heo-related-color:<%= p.main_color || '#425AEF' %>">
        <a href="<%- url_for(p.path) %>" title="<%= p.title %>">
          <% var rc = p.cover || p.top_img || p.thumbnail || ''; %>
          <% if (rc) { %><img class="cover" src="<%- url_for(rc) %>" alt="<%= p.title %>" loading="<%= lb_site('lazyload', true) === false ? 'eager' : 'lazy' %>"><% } %>
          <div class="content is-center">
            <div class="date"><i class="heoblogIcon icon-calendar-todo-fill"></i> <%= date(p.date, 'YYYY-MM-DD') %></div>
            <div class="title"><%= p.title %></div>
          </div>
        </a>
      </div>
      <% }); %>
    </div>
  </div>
  <% } %>

  <hr>

  <div id="post-comment">
    <% if (theme.comments.enable) { %>
    <div class="comment-head">
      <div class="comment-headline"><i class="heoblogIcon icon-chat-1-fill"></i><span> 评论</span></div>
    </div>
    <div class="comment-wrap">
      <% if (theme.comments.use === 'twikoo' && theme.comments.twikoo.envId) { %>
        <div id="twikoo-container"></div>
      <% } else { %>
        <div class="comments-placeholder">请在主题 <code>_config.yml</code> 中填写评论系统的 <code>envId</code>。</div>
      <% } %>
    </div>
    <% } %>
  </div>
</div>

