<%
  /* 关于页 —— 对标 blog.anheyu.com/about/
     ------------------------------------------------------------------
     数据源：source/_data/about.yml
     注意：该 yml 是 **列表**（顶层 `- class_name: 关于页`），
     直接当对象取字段会全线 undefined（旧模板就是这么整页空白的）。 */
  var raw = site.data.about || [];
  var d = Array.isArray(raw) ? (raw[0] || {}) : raw;

  var skills = d.skills || [];
  var careers = d.careers || {};
  var careerList = careers.list || [];
  var statistic = d.statistic || {};
  var statItems = statistic.items || [];
  var mapInfo = d.map || {};
  var selfInfo = d.selfInfo || {};
  var pers = d.personalities || {};
  var maxim = d.maxim || {};
  var buff = d.buff || {};
  var game = d.game || {};
  var comic = d.comic || {};
  var like = d.like || {};
  var music = d.music || {};
  var rewardList = d.reward_list || [];
  var tips = d.aboutsiteTips || {};
  var words = tips.word || [];

  /* 统计数字 */
  var startDate = lb_start_time() || '2024-07-10';
  var days = Math.max(1, Math.floor((Date.now() - new Date(startDate).getTime()) / 86400000));
  var wordCount = 0;
  site.posts.forEach(function (p) { wordCount += String(p.content || '').length; });
  var monthPosts = 0;
  var nowYM = new Date().toISOString().slice(0, 7);
  site.posts.forEach(function (p) {
    if (String(p.date.format('YYYY-MM')) === nowYM) monthPosts++;
  });

  function statValue(it) {
    switch (it.auto) {
      case 'posts': return site.posts.length;
      case 'categories': return site.categories.length;
      case 'tags': return site.tags.length;
      case 'words': return Math.round(wordCount / 10000);
      case 'days': return days;
      case 'monthposts': return monthPosts;
      default: return it.value;
    }
  }

  /* 自信息三项与轮播词的配色 */
  var selfColors = ['#43a6c6', '#c69043', '#b04fe6'];
  var wordColors = ['about-word-c1', 'about-word-c2', 'about-word-c3', 'about-word-c4'];

  /* YAML 会把 2023-03-28 解析成 Date 对象，直接输出会变成
     「Wed Nov 16 2022 08:00:00 GMT+0800 (中国标准时间)」，这里统一成 YYYY-MM-DD */
  function fmtDate(v) {
    if (!v) return '';
    if (typeof v === 'string') return v.slice(0, 10);
    var t = new Date(v);
    if (isNaN(t.getTime())) return String(v);
    var pad = function (n) { return n < 10 ? '0' + n : '' + n; };
    return t.getFullYear() + '-' + pad(t.getMonth() + 1) + '-' + pad(t.getDate());
  }
%>
<div id="page" class="about-page">
  <div class="about-container">

    <%# ---------- 作者头部：左右浮动标签 + 头像 ---------- %>
    <div class="about-author-box">
      <div class="about-author-tag-left">
        <% ((d.avatarSkills || {}).left || []).forEach(function (t) { %>
        <div class="about-author-tag"><%= t %></div>
        <% }); %>
      </div>
      <div class="about-author-img">
        <% if (d.avatarImg) { %><img src="<%- url_for(d.avatarImg) %>" alt="<%= d.name || config.author %>"><% } %>
      </div>
      <div class="about-author-tag-right">
        <% ((d.avatarSkills || {}).right || []).forEach(function (t) { %>
        <div class="about-author-tag"><%= t %></div>
        <% }); %>
      </div>
    </div>

    <div class="about-author-title">关于本站</div>

    <%# ---------- 问候 + 追求 ---------- %>
    <div class="about-row">
      <div class="about-item about-hello">
        <div class="about-title1"><%= d.helloAbout || '你好，很高兴认识你👋' %></div>
        <div class="about-title2">我叫 <span class="about-inline-word"><%= d.name || config.author %></span></div>
        <div class="about-title1"><%= d.description || '' %></div>
      </div>

      <div class="about-item about-site-tips">
        <div class="about-item-tips"><%= tips.tips || '追求' %></div>
        <h2>
          <%= tips.title1 || '源于' %><br><%= tips.title2 || '热爱而去 感受' %>
          <% if (words.length) { %>
          <span class="about-word-mask">
            <% words.forEach(function (w, i) { %>
            <span class="about-word-item <%= wordColors[i % 4] %>"<% if (i === 0) { %> data-show<% } %>><%= w %></span>
            <% }); %>
          </span>
          <% } %>
        </h2>
      </div>
    </div>

    <%# ---------- 技能 + 生涯 ---------- %>
    <div class="about-row">
      <div class="about-item about-skills">
        <div class="about-card-content">
          <div class="about-item-tips"><%= (d.skillsTips || {}).tips || '技能' %></div>
          <span class="about-item-title"><%= (d.skillsTips || {}).title || '开启创造力' %></span>
          <div class="about-skills-group">
            <% if (skills.length) { %>
            <div class="about-skills-wall">
              <div class="about-skills-track">
                <% /* 两遍拼接，让无限滚动衔接得上 */ %>
                <% [0, 1].forEach(function () { %>
                <% for (var si = 0; si < skills.length; si += 2) { %>
                <div class="about-skill-icon-pair">
                  <div class="about-skill-icon" title="<%= skills[si].name %>" style="background:<%= skills[si].color || '#fff' %>">
                    <% if (skills[si].icon) { %><img src="<%- url_for(skills[si].icon) %>" alt="<%= skills[si].name %>" loading="lazy"><% } else { %><span><%= skills[si].name.slice(0, 2) %></span><% } %>
                  </div>
                  <% if (skills[si + 1]) { %>
                  <div class="about-skill-icon" title="<%= skills[si + 1].name %>" style="background:<%= skills[si + 1].color || '#fff' %>">
                    <% if (skills[si + 1].icon) { %><img src="<%- url_for(skills[si + 1].icon) %>" alt="<%= skills[si + 1].name %>" loading="lazy"><% } else { %><span><%= skills[si + 1].name.slice(0, 2) %></span><% } %>
                  </div>
                  <% } %>
                </div>
                <% } %>
                <% }); %>
              </div>
            </div>
            <div class="about-skills-list">
              <% skills.forEach(function (s) { %>
              <span class="about-skill-chip">
                <span class="about-skill-chip-icon" style="background:<%= s.color || '#fff' %>">
                  <% if (s.icon) { %><img src="<%- url_for(s.icon) %>" alt="" loading="lazy"><% } %>
                </span>
                <%= s.name %>
              </span>
              <% }); %>
            </div>
            <% } %>
          </div>
        </div>
      </div>

      <div class="about-item about-careers"<% if (careers.img) { %> style="background-image:url('<%- url_for(careers.img) %>')"<% } %>>
        <div class="about-card-content">
          <div class="about-item-tips"><%= careers.tips || '生涯' %></div>
          <span class="about-item-title"><%= careers.title || '无限进步' %></span>
          <div class="about-careers-group">
            <% careerList.forEach(function (c) { %>
            <div class="about-career-item">
              <span class="about-career-circle" style="background:<%= c.color || '#357ef5' %>"></span>
              <span class="about-career-name"><%= c.desc %></span>
            </div>
            <% }); %>
          </div>
        </div>
      </div>
    </div>

    <%# ---------- 访问统计 + 地图与个人信息 ---------- %>
    <div class="about-row">
      <div class="about-item about-statistic"<% if (statistic.cover) { %> style="background-image:url('<%- url_for(statistic.cover) %>');background-position:center top"<% } %>>
        <div class="about-card-content">
          <div class="about-item-tips">数据</div>
          <span class="about-item-title">访问统计</span>
          <div class="about-statistic-grid">
            <% statItems.forEach(function (it) { %>
            <div class="about-statistic-item">
              <span><%= it.label %></span>
              <span><%= statValue(it) %><% if (it.unit) { %><i><%= it.unit %></i><% } %></span>
            </div>
            <% }); %>
          </div>
          <div class="about-statistic-footer">
            <span class="about-statistic-run">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12c.552 0 1.005-.449.95-.998a10 10 0 0 0-8.953-8.951c-.55-.055-.998.398-.998.95v8a1 1 0 0 0 1 1z"/><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/></svg>
              已运行 <%= days %> 天
            </span>
            <% if (statistic.link) { %>
            <a class="about-stats-btn" href="<%- url_for(statistic.link) %>">
              <%= statistic.text || '文章隧道' %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
            <% } %>
          </div>
        </div>
      </div>

      <div class="about-item-group about-map-info">
        <div class="about-item about-map"<% if (mapInfo.background) { %> style="background-image:url('<%- url_for(mapInfo.background) %>')"<% } %>>
          <span class="about-map-title"><%= mapInfo.title || '我现在住在' %> <b><%= mapInfo.StrengthenTitle || '' %></b></span>
        </div>
        <div class="about-item about-self-info">
          <div class="about-self-item">
            <span class="about-self-label"><%= selfInfo.selfInfoTips1 || '生于' %></span>
            <span class="about-self-value" style="color:<%= selfColors[0] %>"><%= selfInfo.selfInfoContentYear || '' %></span>
          </div>
          <div class="about-self-item">
            <span class="about-self-label"><%= selfInfo.selfInfoTips2 || '' %></span>
            <span class="about-self-value" style="color:<%= selfColors[1] %>"><%= selfInfo.selfInfoContent2 || '' %></span>
          </div>
          <div class="about-self-item">
            <span class="about-self-label"><%= selfInfo.selfInfoTips3 || '现在职业' %></span>
            <span class="about-self-value" style="color:<%= selfColors[2] %>"><%= selfInfo.selfInfoContent3 || '' %></span>
          </div>
        </div>
      </div>
    </div>

    <%# ---------- 性格 + 照片 ---------- %>
    <div class="about-row">
      <div class="about-item about-personalities">
        <div class="about-item-tips">性格</div>
        <div class="about-personality-name"><%= pers.author_name || '' %></div>
        <div class="about-personality-type" style="color:#ac899c"><%= pers.personality_type || '' %></div>
        <% if (pers.name_url) { %>
        <div class="about-post-tips">在 <a href="<%= pers.name_url %>" target="_blank" rel="noopener nofollow">16personalities</a> 了解更多关于 <a href="<%= pers.name_url %>" target="_blank" rel="noopener external nofollow"><%= pers.author_name %></a></div>
        <% } %>
        <% if (pers.personality_img) { %>
        <div class="about-personality-image"><img src="<%- url_for(pers.personality_img) %>" alt="人格" loading="lazy"></div>
        <% } %>
      </div>

      <% if (d.myphoto && d.myphoto.img) { %>
      <div class="about-item about-myphoto">
        <img src="<%- url_for(d.myphoto.img) %>" alt="<%= d.myphoto.alt || '我的照片' %>" loading="lazy">
      </div>
      <% } %>
    </div>

    <%# ---------- 座右铭 + 特长 ---------- %>
    <div class="about-row">
      <div class="about-item about-maxim">
        <div class="about-item-tips"><%= maxim.maxim_tips || '座右铭' %></div>
        <div class="about-maxim-title">
          <span><%= maxim.maxim_top || '' %></span>
          <span><%= maxim.maxim_bottom || '' %></span>
        </div>
      </div>

      <div class="about-item about-buff">
        <div class="about-card-content">
          <div class="about-item-tips"><%= buff.buff_tips || '特长' %></div>
          <div class="about-buff-title">
            <span><%= buff.buff_top || '' %></span>
            <span><%= buff.buff_bottom || '' %></span>
          </div>
        </div>
        <div class="about-buff-bg-icon" aria-hidden="true">
          <svg viewBox="0 0 448 512" fill="currentColor"><path d="M224 256A128 128 0 1 0 224 0a128 128 0 1 0 0 256zm-45.7 48C79.8 304 0 383.8 0 482.3C0 498.7 13.3 512 29.7 512H418.3c16.4 0 29.7-13.3 29.7-29.7C448 383.8 368.2 304 269.7 304H178.3z"/></svg>
        </div>
      </div>
    </div>

    <%# ---------- 游戏 + 番剧 ---------- %>
    <div class="about-row">
      <div class="about-item about-game"<% if (game.game_bg) { %> style="background-image:url('<%- url_for(game.game_bg) %>');background-position:center top"<% } %>>
        <div class="about-card-content">
          <div class="about-item-tips"><%= game.game_tips || '爱好游戏' %></div>
          <span class="about-item-title"><%= game.game_title || '' %></span>
          <div class="about-game-bottom">
            <div class="about-loading-bar" aria-hidden="true"></div>
            <span class="about-game-uid"><%= game.game_uid || '' %></span>
          </div>
        </div>
      </div>

      <div class="about-item about-comic">
        <div class="about-card-content about-comic-content">
          <div class="about-item-tips"><%= comic.comic_tips || '爱好番剧' %></div>
          <div class="about-item-title"><%= comic.comic_title || '追番' %></div>
        </div>
        <div class="about-comic-box">
          <% (comic.comic_list || []).forEach(function (c) { %>
          <a class="about-comic-item" href="<%= c.href %>" target="_blank" rel="noopener noreferrer" title="<%= c.name %>">
            <span class="about-comic-cover"><img src="<%- url_for(c.cover) %>" alt="<%= c.name %>" loading="lazy"></span>
          </a>
          <% }); %>
        </div>
      </div>
    </div>

    <%# ---------- 数码 + 音乐 ---------- %>
    <div class="about-row">
      <div class="about-item about-like-tech"<% if (like.like_bg) { %> style="background-image:url('<%- url_for(like.like_bg) %>');background-size:cover;background-position:center top"<% } %>>
        <div class="about-card-content">
          <div class="about-item-tips"><%= like.like_tips || '关注偏好' %></div>
          <div class="about-item-title"><%= like.like_title || '' %></div>
          <div class="about-content-bottom"><span><%= like.like_bottom || '' %></span></div>
        </div>
      </div>

      <div class="about-item about-like-music"<% if (music.music_bg) { %> style="background-image:url('<%- url_for(music.music_bg) %>');background-size:cover;background-position:center top"<% } %>>
        <div class="about-card-content">
          <div class="about-item-tips"><%= music.music_tips || '音乐偏好' %></div>
          <div class="about-item-title"><%= music.music_title || '' %></div>
          <div class="about-content-bottom"><span>跟 <%= d.name || config.author %> 一起欣赏更多音乐</span></div>
        </div>
        <% if (music.music_link) { %>
        <div class="about-banner-btns">
          <a class="about-banner-btn" href="<%- url_for(music.music_link) %>">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17 3.34a10 10 0 1 1-14.995 8.984L2 12l.005-.324A10 10 0 0 1 17 3.34M15 8H9l-.117.007A1 1 0 0 0 8 9l.007.117A1 1 0 0 0 9 10h2v3a2 2 0 0 0 1.85 1.995L13 15h.15a3.5 3.5 0 1 0-3.15-3.5V7l.007-.117A1 1 0 0 1 11 6h4l.117.007A1 1 0 0 1 16 7v1l-.007.117A1 1 0 0 1 15 8"/></svg>
            <span class="about-banner-btn-text">更多推荐</span>
          </a>
        </div>
        <% } %>
      </div>
    </div>

    <%# ---------- 心路历程（正文取自 about/index.md） ---------- %>
    <% if (page.content) { %>
    <div class="about-story">
      <div class="about-story-item">
        <div class="about-item-tips"><%= (d.story || {}).tips || '心路历程' %></div>
        <div class="about-story-content"><%- page.content %></div>
      </div>
    </div>
    <% } %>

    <%# ---------- 赞赏名单 ---------- %>
    <% if (rewardList.length) { %>
    <% var rewardSorted = rewardList.slice().sort(function (a, b) { return fmtDate(b.datatime).localeCompare(fmtDate(a.datatime)); }); %>
    <div class="about-row">
      <div class="about-item about-reward">
        <div class="about-item-tips">致谢</div>
        <span class="about-item-title"><%= d.reward_title || '赞赏名单' %></span>

        <%# 右上角：为TA充电 + 电路图 + 人数 %>
        <div class="about-reward-charge">
          <div class="about-reward-charge-con"></div>
          <div class="about-reward-charge-btn">
            <div class="about-reward-charge-text">
              <div class="about-reward-charge-light"></div>
              <div class="about-reward-charge-ta">为TA充电</div>
            </div>
          </div>
          <div class="about-reward-charge-tube">
            <svg viewBox="0 0 1028 385" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 77H234.226L307.006 24H790" stroke="#e5e9ef" stroke-width="20"></path><path d="M0 140H233.035L329.72 71H1028" stroke="#e5e9ef" stroke-width="20"></path><path d="M1 255H234.226L307.006 307H790" stroke="#e5e9ef" stroke-width="20"></path><path d="M0 305H233.035L329.72 375H1028" stroke="#e5e9ef" stroke-width="20"></path><rect y="186" width="236" height="24" fill="#e5e9ef"></rect><ellipse cx="790" cy="25.5" rx="25" ry="25.5" fill="#e5e9ef"></ellipse><circle r="14" transform="matrix(1 0 0 -1 790 25)" fill="white"></circle><ellipse cx="790" cy="307.5" rx="25" ry="25.5" fill="#e5e9ef"></ellipse><circle r="14" transform="matrix(1 0 0 -1 790 308)" fill="white"></circle></svg>
            <div class="about-reward-charge-mask">
              <svg viewBox="0 0 1028 385" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 77H234.226L307.006 24H790" stroke="#f25d8e" stroke-width="20"></path><path d="M0 140H233.035L329.72 71H1028" stroke="#f25d8e" stroke-width="20"></path><path d="M1 255H234.226L307.006 307H790" stroke="#f25d8e" stroke-width="20"></path><path d="M0 305H233.035L329.72 375H1028" stroke="#f25d8e" stroke-width="20"></path><rect y="186" width="236" height="24" fill="#f25d8e"></rect><ellipse cx="790" cy="25.5" rx="25" ry="25.5" fill="#f25d8e"></ellipse><circle r="14" transform="matrix(1 0 0 -1 790 25)" fill="white"></circle><ellipse cx="790" cy="307.5" rx="25" ry="25.5" fill="#f25d8e"></ellipse><circle r="14" transform="matrix(1 0 0 -1 790 308)" fill="white"></circle></svg>
            </div>
            <div class="about-reward-charge-orange">
              <svg viewBox="0 0 1028 385" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 77H234.226L307.006 24H790" stroke="#f25d8e" stroke-width="20"></path><path d="M0 140H233.035L329.72 71H1028" stroke="#f25d8e" stroke-width="20"></path><path d="M1 255H234.226L307.006 307H790" stroke="#f25d8e" stroke-width="20"></path><path d="M0 305H233.035L329.72 375H1028" stroke="#f25d8e" stroke-width="20"></path><rect y="186" width="236" height="24" fill="#f25d8e"></rect><ellipse cx="790" cy="25.5" rx="25" ry="25.5" fill="#f25d8e"></ellipse><circle r="14" transform="matrix(1 0 0 -1 790 25)" fill="white"></circle><ellipse cx="790" cy="307.5" rx="25" ry="25.5" fill="#f25d8e"></ellipse><circle r="14" transform="matrix(1 0 0 -1 790 308)" fill="white"></circle></svg>
            </div>
          </div>
          <div class="about-reward-charge-people">共<b><%= rewardList.length %></b>人</div>
        </div>

        <div class="about-reward-desc"><%= d.reward_desc || '感谢因为有你们，让我更加有创作的动力。' %></div>
        <div class="about-reward-list">
          <% rewardSorted.forEach(function (r) { %>
          <div class="about-reward-item">
            <div class="about-reward-name"><%= r.name %></div>
            <div class="about-reward-bottom">
              <div class="about-reward-money<%= r.amount >= 50 ? ' is-large' : '' %>">¥<%= r.amount %><%= r.suffix || '元' %></div>
              <div class="about-reward-time"><%= fmtDate(r.datatime) %></div>
            </div>
          </div>
          <% }); %>
        </div>
        <div class="about-reward-update">最新更新时间：<time class="about-reward-update-time"><%= fmtDate(rewardSorted[0].datatime) %></time></div>
      </div>
    </div>
    <% } %>

    <%# ---------- 评论 ---------- %>
    <% if (theme.comments.enable && page.comments !== false) { %>
    <div class="about-comments post-comments">
      <div class="item-headline"><i class="heoblogIcon icon-chat-1-fill"></i><span>评论</span></div>
      <% if (theme.comments.use === 'twikoo' && theme.comments.twikoo.envId) { %>
        <div id="twikoo-container"></div>
      <% } else { %>
        <div class="comments-placeholder">请在主题 <code>_config.yml</code> 中配置评论系统（如 twikoo 的 <code>envId</code>）。</div>
      <% } %>
    </div>
    <% } %>

  </div>
</div>

<%# ---------- 为TA充电 → 打赏弹窗 ---------- %>
<% var rewardQrs = ((theme.post || {}).copyright || {}).reward_images || []; %>
<% if (rewardQrs.length) { %>
<div class="about-reward-dialog-mask" id="about-reward-dialog" hidden>
  <div class="about-reward-dialog" role="dialog" aria-modal="true" aria-label="打赏支持">
    <div class="about-reward-dialog-header">
      <h3 class="about-reward-dialog-title">打赏支持</h3>
      <button class="about-reward-dialog-close" type="button" aria-label="关闭">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
      </button>
    </div>
    <div class="about-reward-dialog-body">
      <p class="about-reward-tips"><%= d.reward_tips || '感谢您的支持，您的鼓励是我创作的最大动力！' %></p>
      <div class="about-reward-qrcodes">
        <% rewardQrs.forEach(function (q) { %>
        <% var qimg = typeof q === 'string' ? q : (q.img || ''); %>
        <% var qname = typeof q === 'string' ? '打赏' : (q.name || '打赏'); %>
        <% if (qimg) { %>
        <div class="about-reward-qrcode-item">
          <img class="about-reward-qr-image" src="<%= qimg %>" alt="<%= qname %>打赏" loading="lazy">
          <div class="about-reward-qr-label"><%= qname %></div>
        </div>
        <% } %>
        <% }); %>
      </div>
    </div>
  </div>
</div>
<% } %>
