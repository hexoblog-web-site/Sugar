<%#
  搜索弹层
  ---------------------------------------------------------------------------
  三件套：模板 search.ejs · 样式 source/css/search.css · 脚本 source/js/partial/search.js

  DOM 结构与 blog.zhheo.com 的 #heosearch 对齐，脚本按这些 id 取节点：
    #heosearch-navbar    标题 + 关闭按钮
    #heosearch-input     输入框容器（.ais-search-box 是 Algolia 的老类名，样式沿用）
    #local-search-input  真正的输入框
    #heosearch-search-btn 搜索按钮
    #heosearch-tabs      综合 / 文章 两个 tab
    #heosearch-hits      结果区（命中列表 或 推荐位）
    #heosearch-suggests  预留的建议区
    #heosearch-stats     「找到 N 条…」统计行
    #heosearch-pager     分页器
    #search-mask         遮罩，点它关闭

  改一处：先看这里有没有对应的 id，没有再加，别直接改 id 名（脚本认的是 id）。
%>
<div id="heosearch">
  <div class="search-dialog">
    <div id="heosearch-navbar">
      <div class="search-dialog__title" id="heosearch-title">搜索</div>
      <span class="search-close-button" role="button" tabindex="0" aria-label="关闭搜索" onclick="heo.closeSearch()">
        <i class="heoblogIcon icon-close-fill"></i>
      </span>
    </div>
    <div id="heosearch-input-panel">
      <div id="heosearch-input">
        <div class="ais-search-box">
          <input class="ais-search-box--input" id="local-search-input" type="text"
                 placeholder="输入关键词搜索" autocomplete="off" spellcheck="false">
        </div>
        <button id="heosearch-search-btn" type="button" title="搜索" aria-label="搜索" onclick="heo.runSearch()">
          <i class="heoblogIcon icon-search-2-line"></i>
        </button>
      </div>
    </div>
    <div id="heosearch-tabs">
      <span class="php-search-tab active" data-type="all">综合</span>
      <span class="php-search-tab" data-type="post">文章</span>
    </div>
    <div id="heosearch-results">
      <div id="heosearch-hits"></div>
      <div id="heosearch-suggests"></div>
    </div>
    <div id="heosearch-stats"></div>
    <ul id="heosearch-pager" class="ais-pagination pagination"></ul>
  </div>
  <div id="search-mask" onclick="heo.closeSearch()"></div>
</div>
