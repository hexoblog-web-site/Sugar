<%#
  首页顶部两栏：左「全站推荐」轮播 + 右「新品框架」推荐墙
  ---------------------------------------------------------------------------
  右边这块对齐的是安知鱼主题首页右侧的 topGroup：

    默认   一张「新品框架」封面把下面的 6 篇文章整个盖住（只看到封面）
    悬停   封面淡出，露出 3×2 六张文章卡；鼠标移开，封面回来
    悬停按钮  封面不动（脚本加 .hold）—— 否则按钮跟着封面一起消失，点不到
    触屏   点封面展开 / 收回，点右下角按钮去「更多」页面（配了 link 的话）

  遮罩中间那行字由 new_frame.hello 决定，三种模式：
    lottie  原版手写 hello（默认）。播放器 lottie-web 按需注入，播的是参考站
            那张卡用的动画文件本身 —— 换笔迹只换 new_frame.hello.lottie.src
    text    换成自己的字：CSS 变量控制的尺寸 + 彩虹渐变 + 从左往右擦出
    off     不显示
  尺寸 / 渐变 / 时长都从配置写成内联 CSS 变量，样式表里用 var(名字, 默认值) 接，
  所以不配就是主题默认的样子。详见 css/home-top.css 里 .new-frame-hello-text 段。

  遮罩下面放哪几篇：不是「最新那几篇」（那样和下面的列表一字不差地重），
  而是从「不在首页第一页、也没被左边幻灯片用掉」的文章里按时间倒序取，
  同一封面只上一次（new_frame.cover_dedupe，默认开）；
  配了 new_frame.items 就按 items 来。
  规则写在 scripts/sugar-home-pick.js（两块的选文都归它管，免得各算一套）。

  模板 home/home-top.ejs · 样式 css/home-top.css · 脚本 js/partial/home-top.js
  配置 theme.home.home_top.new_frame
  轮播没有内容时整块不渲染。
%>
<%
  var top = theme.home.home_top || {};
  var nf = top.new_frame || {};
  var swiperHtml = partial('_partial/home/home-swiper');
  var hasSwiper = swiperHtml && swiperHtml.replace(/\s/g, '').length > 0;

  /* 3 列 × 2 行刚好铺满 600×340，配多了会溢出这块的高度，所以卡死在 6 */
  var nfCount = Math.min(parseInt(nf.count, 10) || 6, 6);

  /* ---------- 挑文章：有封面的优先，没封面的补位 ----------
     不再取「首页第一页」—— 那样和下面的列表是同一批，滚下去等于什么都没翻新。
     交给 lb_home_pick：池子 = 全部文章 － 首页第一页 － 幻灯片已用掉的，
     所以右上框和下面列表、左边幻灯片都不重样。见 scripts/sugar-home-pick.js */
  var picks = lb_home_pick('frame', nfCount) || [];

  var nfName = nf.name || '新品框架';
  var nfTitle = nf.title || '';
  var nfButton = nf.button || '更多推荐';
  /* 右下角按钮跳到哪：配了就是真链接，留空则只是个「展开」按钮 */
  var nfLink = nf.link ? url_for(nf.link) : '';
  var nfOuter = /^https?:/i.test(String(nf.link || ''));
  /* 开关只认 new_frame.enable。top.enable 是老配置里的外层开关，已经删掉了，
     这里留着判断只是为了老配置写了 false 时不至于忽然又冒出来。 */
  var nfOn = top.enable !== false && nf.enable !== false && picks.length > 0;

  /* 封面对齐首页卡片那套兜底：文章没封面时用 post.default_cover，
     也没有就留空（.new-frame-item-cover 有底色，空图不至于露破洞）。
     原来的 theme.error_img.post_page 在本主题配置里根本不存在，
     一旦真的走到兜底就整页 500 —— 这里换掉。 */
  function coverOf(p) { return p.cover || p.top_img || p.thumbnail || theme.post.default_cover || ''; }

  /* ---------- 遮罩中间那行字：把配置归一成 h ----------
     新写法是 new_frame.hello 这个对象（mode: lottie / text / off）；
     旧写法 hello: true / hello: false / hello: 一段文字，以及顶层的
     hello_lottie 都还认，两种在这里合流，下面模板只认 h.mode。
     配置项说明全在 themes/Sugar/_config.yml 的 new_frame 段。 */
  var hRaw = nf.hello;
  var h = {};
  if (hRaw === false || hRaw === null) h.mode = 'off';
  else if (hRaw === true || hRaw === undefined) h.mode = 'lottie';
  else if (typeof hRaw === 'object') { for (var hk in hRaw) { if (hk) h[hk] = hRaw[hk]; } }
  else { h.mode = 'text'; h.text = String(hRaw); }
  if (!h.mode) h.mode = h.text ? 'text' : 'lottie';
  h.mode = String(h.mode).toLowerCase();
  if (h.mode !== 'lottie' && h.mode !== 'text') h.mode = 'off';

  var hText = (h.text === undefined || h.text === null) ? '' : String(h.text);
  if (h.mode === 'text' && !hText) h.mode = 'off';   /* text 但没写字 = 不显示 */
  var hFallback = (h.fallback === undefined || h.fallback === null) ? 'hello' : String(h.fallback);
  var hReplay = h.replay !== false;

  /* 文字版的所有可调项都写成 CSS 变量：样式表里用 var(名字, 默认值) 接，
     不配就是主题现在的样子，配了只覆盖改到的那几项。 */
  var hs = h.text_style || {};
  var hVars = [];
  function nfVar(name, val) {
    if (val === undefined || val === null || val === '') return;
    hVars.push(name + ':' + val);
  }
  nfVar('--nf-hello-fs', hs.font_size);
  nfVar('--nf-hello-fw', hs.font_weight);
  nfVar('--nf-hello-ls', hs.letter_spacing);
  nfVar('--nf-hello-lh', hs.line_height);
  nfVar('--nf-hello-maxw', hs.max_width);
  nfVar('--nf-hello-ease', hs.write_easing);
  var hDur = parseFloat(hs.write_duration);
  if (hDur > 0) hVars.push('--nf-hello-dur:' + hDur + 's');

  /* gradient：数组里每项「位置 颜色」或「颜色 位置」，也允许只写颜色
     （只写颜色时按顺序均分）。也可以整段写成一个 CSS 渐变字符串，原样透传。 */
  var hGrad = '';
  var nfIsColor = function (t) { return /^(#|rgb|hsl|var\()/i.test(t); };
  if (typeof hs.gradient === 'string') {
    hGrad = hs.gradient;
  } else if (hs.gradient && hs.gradient.length) {
    var gStops = [];
    var gLen = hs.gradient.length;
    for (var gi = 0; gi < gLen; gi++) {
      var gItem = String(hs.gradient[gi]).trim();
      if (!gItem) continue;
      var gParts = gItem.split(/\s+/);
      var gColor = gParts[0];
      var gPos = gParts[1] || '';
      /* 写成「20% #fff」的也认：位置和颜色换个顺序而已 */
      if (gPos && !nfIsColor(gColor) && nfIsColor(gPos)) {
        gColor = gParts[1];
        gPos = gParts[0];
      }
      if (!gPos) gPos = gLen > 1 ? Math.round(gi * 100 / (gLen - 1)) + '%' : '0%';
      gStops.push(gColor + ' ' + gPos);
    }
    if (gStops.length) hGrad = 'linear-gradient(90deg, ' + gStops.join(', ') + ')';
  }
  if (hGrad) hVars.push('--nf-hello-grad:' + hGrad);
  var hStyle = hVars.length ? ' style="' + hVars.join(';') + '"' : '';

  /* ---------- 遮罩进出时长 → CSS 变量 ---------- */
  var nfMask = nf.mask || {};
  var mOut = parseFloat(nfMask.fade_out); if (!(mOut >= 0)) mOut = 5;
  var mIn = parseFloat(nfMask.fade_in); if (!(mIn >= 0)) mIn = 1.6;
  var nfMaskStyle = '--nf-mask-out:' + mOut + 's;--nf-mask-in:' + mIn + 's';
  /* 封面底色留空就用样式表里的默认渐变（原站那张卡的浅绿→浅粉） */
  if (nfMask.cover_bg) nfMaskStyle += ';--nf-cover-bg:' + nfMask.cover_bg;
%>
<%
  /* 两块各自开关：谁开谁上；两个都关就整条通栏不渲染（首页直接从「即刻」开始） */
  var rowCls = [];
  if (!hasSwiper) rowCls.push('no-swiper');
  if (!nfOn) rowCls.push('no-new-frame');
%>
<% if (hasSwiper || nfOn) { %>
<section class="home-top-full">
<%# class 只输出值、不拼属性：拼整段属性时引号会被转义成 &#34;，类名就失效了 %>
<% if (rowCls.length) { %>
<div id="home_top_row" class="<%= rowCls.join(' ') %>">
<% } else { %>
<div id="home_top_row">
<% } %>
  <% if (hasSwiper) { %>
  <div id="home_swiper_slot"><%- swiperHtml %></div>
  <% } %>

  <% if (nfOn) { %>
  <div id="new_frame_group" class="new-frame-group"
       style="<%- nfMaskStyle %>"
       data-hello-replay="<%= hReplay ? 1 : 0 %>">
    <div class="new-frame-grid">
      <% picks.forEach(function (p) { %>
      <%# 手动条目可能写外链：外链原样输出，站内的才走 url_for；
          新窗口看 target（写了听它的，没写就外链才新窗口） %>
      <% var pOuter = /^https?:/i.test(String(p.path || '')); %>
      <a class="new-frame-item" href="<%- pOuter ? p.path : url_for(p.path) %>" title="<%= p.title %>"<% if (p.newTab) { %> target="_blank" rel="noopener"<% } %>>
        <div class="new-frame-item-cover">
          <span class="new-frame-item-badge">荐</span>
          <%# alt 留空：标题就在图下面，读屏不用把同一句话念两遍 %>
          <% var pCover = coverOf(p); %>
          <% if (pCover) { %>
          <img src="<%- url_for(pCover) %>" alt="" loading="lazy" decoding="async" width="200" height="112">
          <% } %>
        </div>
        <div class="new-frame-item-info">
          <span class="new-frame-item-title"><%= p.title %></span>
        </div>
      </a>
      <% }); %>
    </div>

    <%# 遮罩：盖在 6 张卡上面。悬停 / 展开时淡出，让下面的卡露出来 %>
    <div id="new_frame_card" class="new-frame-card">
      <%# 遮罩中间那行字。三种模式由 new_frame.hello.mode 决定（见文件头的配置说明）：
           lottie  原版手写 hello：播放器按需注入，播的是参考站那个动画文件本身
           text    自己的字：彩虹渐变 + 从左往右擦出
           off     不渲染，遮罩上只留左下文字块和右下按钮
           具体情况在文件上半部分解析，这里只按 h.mode 出结构 %>
      <% if (h.mode === 'lottie') { %>
      <%
        var hl = h.lottie || {};
        /* 旧写法 new_frame.hello_lottie 还在的话当兜底 */
        var hSrc = hl.src || nf.hello_lottie || '/lib/hello.json';
        var hLib = hl.lib || '/lib/lottie_light.min.js';
        var hLoop = hl.loop === true;
        var hSpeed = parseFloat(hl.speed); if (!(hSpeed > 0)) hSpeed = 1;
        var hLazy = hl.lazy !== false;
      %>
      <div class="new-frame-hello new-frame-hello-lottie" id="new_frame_hello"
           role="img" aria-label="hello"
           data-src="<%- url_for(hSrc) %>?v=<%= lb_asset_ver(hSrc) %>"
           data-lib="<%- url_for(hLib) %>?v=<%= lb_asset_ver(hLib) %>"
           data-renderer="<%= hl.renderer || 'svg' %>"
           data-par="<%= hl.preserve_aspect_ratio || 'xMidYMid meet' %>"
           data-loop="<%= hLoop ? 1 : 0 %>"
           data-speed="<%= hSpeed %>"
           data-lazy="<%= hLazy ? 1 : 0 %>"
           data-fallback="<%= hFallback %>"></div>
      <% } else if (h.mode === 'text') { %>
      <%# 自定义文字：跟手写版共用 .new-frame-hello 这个类，所以淡出/放大那套
           过渡不用重写；尺寸、渐变、擦出时长全部来自上面算好的 CSS 变量 %>
      <div class="new-frame-hello new-frame-hello-text"<%- hStyle %>><%= hText %></div>
      <% } %>
      <div class="new-frame-card-info">
        <div class="new-frame-card-tips"><%= nfName %></div>
        <% if (nfTitle) { %><div class="new-frame-card-title"><%= nfTitle %></div><% } %>
      </div>
      <div class="new-frame-card-action">
        <%# 配了 link 就是真链接，点它去「更多」那个页面；
            没配就退化成按钮，只在触屏上当「展开」用 %>
        <% if (nfLink) { %>
        <a class="banner-button" href="<%- nfLink %>"<% if (nfOuter) { %> target="_blank" rel="noopener"<% } %>>
          <span class="banner-button-icon"><i class="heoblogIcon icon-arrow-right-s-line"></i></span>
          <span class="banner-button-text"><%= nfButton %></span>
        </a>
        <% } else { %>
        <button class="banner-button" type="button" aria-expanded="false" aria-controls="new_frame_group">
          <span class="banner-button-icon"><i class="heoblogIcon icon-arrow-right-s-line"></i></span>
          <span class="banner-button-text"><%= nfButton %></span>
        </button>
        <% } %>
      </div>
    </div>
  </div>
  <% } %>
</div>
</section>
<% } %>
