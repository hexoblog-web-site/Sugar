<div id="rightside">
  <div id="rightside-config-hide">
    <button id="darkmode" type="button" title="浅色和深色模式转换" onclick="heo.toggleDarkMode()">
      <i class="heoblogIcon icon-moon-clear-fill"></i>
    </button>
    <button id="hide-aside-btn" type="button" title="单栏和双栏切换" onclick="heo.toggleAside()">
      <i class="heoblogIcon icon-side-bar-fill"></i>
    </button>
  </div>
  <div id="rightside-config-show">
    <button id="rightside_config" type="button" title="设置" onclick="heo.toggleRightside()">
      <i class="heoblogIcon icon-tools-fill"></i>
    </button>
    <button id="go-up" type="button" title="回到顶部" onclick="heo.scrollToDest(0, 500)">
      <i class="heoblogIcon icon-arrow-up-line"></i>
    </button>
  </div>
</div>
