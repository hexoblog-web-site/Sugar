<%
  /* 即刻短文（/essay/）—— 布局对标 blog.anheyu.com/essay
   *
   * 与目标页唯一的差别：目标页是 3 列瀑布卡片，这里按需求改成「单列列表卡片」，
   * 卡片的视觉语言（白底 / 12px 圆角 / 1px #E3E8F7 描边 / 0 8px 16px -4px 阴影 /
   * 底部胶囊信息条）全部照抄目标站实测值，只把排列方向从 grid 换成 column。
   *
   * 三件套：
   *   模板  layout/essay.ejs            （本文件）
   *   样式  source/css/essay-page.css
   *   脚本  source/js/partial/essay-page.js
   *
   * 列表走静态分页：本文件只渲染当前页的 page_size 条，第 2 页起由
   * scripts/sugar-essay-pager.js 生成的 /essay/page/N/ 承接。翻页是真跳转，
   * 所以首屏不必背着一整份列表，页码也能被分享和收录。
   *
   * 文案 / 背景图 / 每屏条数都在主题 _config.yml 的 essay.page 段改，
   * 字段命名与 friends_lite 保持一致（tips / title / bottom_left / bottom_right /
   * bottom_right_link / top_background / overlay），两个页面可以对着改。
   *
   * 数据源：source/_data/vignette.yml（顶层是列表，每条 title / date / author / content / images）
   */
  var cfg = theme.essay || {};
  var ep = cfg.page || {};
  var list = (site.data && site.data.vignette) || [];

  var epEnabled = ep.enable !== false;
  var epImage = page.banner || ep.top_background || '';
  var epOverlay = (ep.overlay === 0 || ep.overlay) ? ep.overlay : 0.4;
  var epTips = ep.tips || '随时随地，分享生活';
  var epTitle = ep.title || '即刻短文';
  var epDesc = ep.bottom_left || '';
  var epBtnText = ep.bottom_right || '';
  var epBtnHref = ep.bottom_right_link ? url_for(ep.bottom_right_link) : '';
  var epPerPage = parseInt(ep.page_size, 10);
  if (!(epPerPage > 0)) epPerPage = 8;
  var epAvatar = ep.error_img || '/images/avatar.jpg';

  /* 静态分页：第 1 页由 source/essay/index.md 出（没有 essay_pager），
     第 2..N 页由 scripts/sugar-essay-pager.js 注册的 generator 出。
     这里统一算出「当前第几页 / 共几页 / 本页从第几条开始」，
     后面渲染列表和分页条都只认这几个值。 */
  var epPager = page.essay_pager || null;
  var epCur = epPager ? epPager.current : 1;
  var epTotal = epPager ? epPager.total : Math.max(1, Math.ceil(list.length / epPerPage));
  var epStart = (epCur - 1) * epPerPage;
  var epList = list.slice(epStart, epStart + epPerPage);
  var epBase = url_for('/essay').replace(/\/$/, '');

  var epBannerStyle = (epImage ? 'background-image:url(\'' + epImage + '\');' : '') + '--fc-overlay:' + epOverlay + ';';

  /* date 支持 2024/07/11、2024-07-11、带时间三种写法，转成可排序的 ISO */
  function epDate(v) {
    if (!v) return { iso: '', text: '' };
    var s = String(v).trim();
    var m = s.match(/^(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})/);
    if (!m) return { iso: '', text: s };
    var iso = m[1] + '-' + ('0' + m[2]).slice(-2) + '-' + ('0' + m[3]).slice(-2);
    return { iso: iso, text: iso };
  }
%>
<% if (!epEnabled) { %>
<script>location.replace(<%- JSON.stringify(url_for('/404.html')) %>);</script>
<% } else { %>
<div class="essay-page">

  <%# ---------- 顶部横幅（结构与朋友圈页共用 .fc-banner） ---------- %>
  <div class="fc-banner<%= epImage ? '' : ' fc-banner--plain' %>">
    <div class="fc-banner-inner" style="<%= epBannerStyle %>">
      <div class="fc-banner-content">
        <div class="fc-banner-head">
          <div class="fc-banner-tips"><%= epTips %></div>
          <h1 class="fc-banner-title"><%= epTitle %></h1>
        </div>
        <div class="fc-banner-bottom">
          <div class="fc-banner-desc"><%= epDesc %></div>
          <% if (epBtnText && epBtnHref) { %>
          <a class="fc-banner-button" href="<%- epBtnHref %>">
            <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="fc-banner-button-icon" width="20" height="20" viewBox="-2 -2 24 24">
              <path fill="currentColor" d="M13.828 7.172a.997.997 0 0 0-1-1h-6a1 1 0 1 0 0 2h3.586l-3.95 3.95a1 1 0 0 0 1.415 1.414l3.95-3.95v3.586a1 1 0 0 0 2 0v-6zM10 20C4.477 20 0 15.523 0 10S4.477 0 10 0s10 4.477 10 10s-4.477 10-10 10"/>
            </svg>
            <span><%= epBtnText %></span>
          </a>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <%# ---------- 列表 ---------- %>
  <% if (!list.length) { %>
  <div class="essay-empty">
    <p>还没有即刻短文。</p>
    <p class="essay-empty-tip">在 <code>source/_data/vignette.yml</code> 里按格式加一条就会出现在这里。</p>
  </div>
  <% } else { %>
  <ul class="essay-list" id="essay-list">
    <% epList.forEach(function (it, i) {
         var d = epDate(it.date);
         var author = it.author || {};
         var name = author.name || config.author || '';
         var avatar = author.avatar || epAvatar;
         var imgs = (it.images || []).filter(Boolean);
         /* 全局序号：翻页后点赞的 localStorage key 仍然指向同一条说说，
            只用本页的 i 会串到上一页/下一页的条目上 */
         var gi = epStart + i;
    %>
    <li class="essay-item" data-index="<%= gi %>">
      <div class="essay-head">
        <img class="essay-avatar" src="<%- url_for(avatar) %>" alt="<%= name %>" loading="lazy" width="40" height="40"
             onerror="this.onerror=null;this.src='<%- url_for(epAvatar) %>'">
        <div class="essay-byline">
          <span class="essay-author"><%= name %></span>
          <time class="essay-date" datetime="<%= d.iso %>"><%= d.text %></time>
        </div>
      </div>

      <% if (it.title) { %>
      <h2 class="essay-title"><%= it.title %></h2>
      <% } %>

      <% if (it.content) { %>
      <div class="essay-text"><%- it.content %></div>
      <% } %>

      <% if (imgs.length) { %>
      <%
        /* 鼠标滑过图片时在图片下方浮出的文字：取这条说说的正文，去掉标签压成一行。
           两行的容量约 55 字，超了截断加省略号（目前最长 40 字，远没到） */
        var capText = String(it.content || '').replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
        if (capText.length > 56) capText = capText.slice(0, 56) + '…';

        /* 两图一屏：一屏放 2 张，多出来的收进下一页，用左右按钮翻。
           4 张 = 2 屏；3 张 = 2 屏（末屏 1 张，留在左格，与首页第一张对齐）；
           2 张 = 1 屏，不出按钮；1 张 = 单图撑满整行。 */
        var perScreen = 2;
        var screens = Math.ceil(imgs.length / perScreen);
        var gcls = 'essay-gallery';
        if (screens > 1) gcls += ' essay-gallery--multi';
        if (imgs.length === 1) gcls += ' essay-gallery--single';
      %>
      <div class="<%= gcls %>" data-screens="<%= screens %>">
        <div class="essay-gallery-viewport">
          <div class="essay-gallery-track">
            <% for (var sc = 0; sc < screens; sc++) { %>
            <div class="essay-gallery-page">
              <% imgs.slice(sc * perScreen, sc * perScreen + perScreen).forEach(function (src) { %>
              <a class="essay-img" href="<%- url_for(src) %>" target="_blank" rel="noopener">
                <img src="<%- url_for(src) %>" alt="" loading="lazy">
                <% if (capText) { %><span class="essay-img-cap"><%= capText %></span><% } %>
              </a>
              <% }); %>
            </div>
            <% } %>
          </div>
        </div>

        <% if (screens > 1) { %>
        <button class="essay-gallery-nav essay-gallery-nav--prev" type="button" aria-label="上一张">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 320 512" aria-hidden="true"><path fill="currentColor" d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l192 192c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L77.3 256 246.6 86.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-192 192z"/></svg>
        </button>
        <button class="essay-gallery-nav essay-gallery-nav--next" type="button" aria-label="下一张">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 320 512" aria-hidden="true"><path fill="currentColor" d="M310.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-192 192c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L242.7 256 73.4 86.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l192 192z"/></svg>
        </button>
        <div class="essay-gallery-dots" aria-hidden="true">
          <% for (var dc = 0; dc < screens; dc++) { %><i<%= dc === 0 ? ' class="is-active"' : '' %>></i><% } %>
        </div>
        <% } %>
      </div>
      <% } %>

      <hr class="essay-hr">

      <div class="essay-bottom">
        <div class="essay-info">
          <span class="essay-pill essay-pill--time">
            <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" width="12" height="12" viewBox="0 0 512 512">
              <path fill="currentColor" d="M256 0a256 256 0 1 1 0 512a256 256 0 1 1 0-512m-24 120v136c0 8 4 15.5 10.7 20l96 64c11 7.4 25.9 4.4 33.3-6.7s4.4-25.9-6.7-33.3L280 243.2V120c0-13.3-10.7-24-24-24s-24 10.7-24 24"/>
            </svg>
            <time class="essay-ago" datetime="<%= d.iso %>"><%= d.text %></time>
          </span>
          <% if (imgs.length) { %>
          <span class="essay-pill">
            <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" width="12" height="12" viewBox="0 0 512 512">
              <path fill="currentColor" d="M0 96C0 60.7 28.7 32 64 32h384c35.3 0 64 28.7 64 64v320c0 35.3-28.7 64-64 64H64c-35.3 0-64-28.7-64-64zm64 0v320h384V96zm144 48c0-26.5 21.5-48 48-48s48 21.5 48 48s-21.5 48-48 48s-48-21.5-48-48m-96 224c0-53 43-96 96-96h96c53 0 96 43 96 96v16H112z"/>
            </svg>
            <span><%= imgs.length %> 张图</span>
          </span>
          <% } %>
        </div>
        <button type="button" class="essay-like" data-key="essay-<%= gi %>" aria-pressed="false" aria-label="点赞">
          <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" width="18" height="18" viewBox="0 0 512 512">
            <path fill="currentColor" d="M241 87.1l15 20.7l15-20.7C296 52.5 336.2 32 378.9 32C452.4 32 512 91.6 512 165.1v2.6c0 17.6-3.4 35.1-9.9 51.3c-16.5 38.5-39.2 74.8-66.6 107.1l-.1 .1c-26.8 31.6-56.7 60.4-89.1 85.3l-.9 .7L284.4 456c-16.2 12.6-38.6 12.6-54.8 0L168.5 411l-.1-.1c-32.1-24.6-61.8-53.1-88.5-84.4c-27.5-32.3-50.2-68.6-66.7-107.2c-6.5-16.2-9.9-33.7-9.9-51.3v-2.6C3.2 91.6 62.8 32 136.3 32c42.7 0 82.9 20.5 104.7 55.1z"/>
          </svg>
          <span class="essay-like-count">0</span>
        </button>
      </div>
    </li>
    <% }); %>
  </ul>

  <%# ---------- 静态分页：页码就是真实 URL，爬虫和直接分享都能落到第 N 页 ---------- %>
  <% if (epTotal > 1) { %>
  <div class="essay-pager">
    <%- partial('_partial/pagination', { page: { total: epTotal, current: epCur, base: epBase } }) %>
    <%# 手机上主题把页码圆点藏了（只留上/下页两个胶囊），这里补一句「第几 / 共几」 %>
    <div class="essay-pager-count"><%= epCur %> / <%= epTotal %></div>
  </div>
  <% } %>
  <% } %>

  <%# ---------- 评论（与文章页同一套 twikoo，未启用则不渲染） ---------- %>
  <% if (theme.comments && theme.comments.enable) { %>
  <hr class="essay-comment-hr">
  <div id="post-comment">
    <div class="comment-head">
      <div class="comment-headline"><i class="heoblogIcon icon-chat-1-fill"></i><span> 评论</span></div>
    </div>
    <div class="comment-wrap">
      <% if (theme.comments.use === 'twikoo' && theme.comments.twikoo.envId) { %>
      <div id="twikoo-container"></div>
      <% } else { %>
      <div class="comments-placeholder">请在主题 <code>_config.yml</code> 中填写评论系统的 <code>envId</code>。</div>
      <% } %>
    </div>
  </div>
  <% } %>

</div>

<%# 侧栏：必须放在 .essay-page 外面平级，否则会被挤进内容列里当兄弟节点 %>
<% if (lb_sidebar_cfg().enable !== false) { %>
  <%- partial('_partial/aside') %>
<% } %>
<% } %>
